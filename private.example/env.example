# Copy to private/env and fill in real values.
# Source before launching: source private/env

# --- Model provider (any OpenAI-compatible endpoint) ---
# ORCHESTRA_API_KEY is also stored as a SkyPilot API-server secret and
# resolved at launch time (see main-box.yaml `secrets:`).
export ORCHESTRA_API_KEY="sk-your-provider-api-key"
export ORCHESTRA_BASE_URL="https://your-provider.example.com/v1"
# Optional: initial model for new TUI sessions. Switch anytime with /model
# inside a session — the switch survives pi restarts.
# export ORCHESTRA_MODEL="your-model-id"

# --- SkyPilot ---
export SKY_API_ENDPOINT="https://your-skypilot-api-server.example.com"
export SKY_API_TOKEN="sky_your_service_account_token"
export SKY_INFRA="k8s/your-context-name"
