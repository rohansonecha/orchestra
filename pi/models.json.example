{
  "providers": {
    "orchestra": {
      "baseUrl": "https://your-provider.example.com/v1",
      "api": "openai-completions",
      "apiKey": "!printf %s ${ORCHESTRA_API_KEY:-$GLM_API_KEY}",
      "models": [
        {
          "id": "your-model-id",
          "name": "Your Model",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 262144,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        },
        {
          "id": "your-second-model-id",
          "name": "Your Second Model",
          "reasoning": false,
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 32768,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
